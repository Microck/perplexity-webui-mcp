# Perplexity session token cookie value (__Secure-next-auth.session-token)
# Fastest: uvx --with rich --from "perplexity-webui-scraper@latest" get-perplexity-session-token
# Get this from browser DevTools -> Application -> Cookies -> perplexity.ai
PERPLEXITY_SESSION_TOKEN=

# Optional: one proxy URL that the wrapper expands to HTTP_PROXY / HTTPS_PROXY / ALL_PROXY
# Examples:
# PERPLEXITY_PROXY_URL=http://127.0.0.1:8080
# PERPLEXITY_PROXY_URL=socks5://127.0.0.1:1080
PERPLEXITY_PROXY_URL=

# Optional: bypass proxy for local routes
PERPLEXITY_NO_PROXY=localhost,127.0.0.1
